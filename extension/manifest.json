{
  "manifest_version": 3,
  "name": "Better Growave",
  "version": "0.3.1",
  "description": "Compact Growave wishlists with stock filters, list/tile views, and a cart sidebar. Tested on Turntable Lab; other stores are experimental.",
  "homepage_url": "https://github.com/mweint/better-growave",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {"default_title": "Improve this Growave wishlist"},
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{
    "matches": ["https://www.turntablelab.com/pages/wishlist*"],
    "js": ["core.js", "cart.js", "content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko_android": {"strict_min_version": "142.0"},
    "gecko": {
      "id": "better-wishlist@ttl-local.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
